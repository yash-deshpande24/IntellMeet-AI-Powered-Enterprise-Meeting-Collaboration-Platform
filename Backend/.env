# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection (Use free tier connection string or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet

# Security & JWT
JWT_SECRET=intellmeet-super-secret-key-enterprise-2026

# AI Engine (Optional - Leave empty for automatic zero-cost built-in AI synthesizer fallback)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Cloudinary Free Tier (Optional - Leave empty for automatic zero-cost Base64 data storage fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email / SMTP Configuration for Zoom-Style Meeting Invitations (Optional - Simulated mode fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="IntellMeet Conferences" <no-reply@intellmeet.io>

# Client URLs for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
