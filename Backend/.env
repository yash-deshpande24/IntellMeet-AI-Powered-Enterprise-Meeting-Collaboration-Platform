# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection (Use free tier connection string or local MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/intellmeet

# Security & JWT
JWT_SECRET=intellmeet-super-secret-key-enterprise-2026

# AI Engine (Optional - Leave empty for automatic zero-cost built-in AI synthesizer fallback)
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini

# Cloudinary Free Tier (Optional - Leave empty for automatic zero-cost Base64 data storage fallback)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Client URLs for CORS
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
